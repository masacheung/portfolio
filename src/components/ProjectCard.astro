---
import type { Project } from '../data/projects';
const { project, big = false } = Astro.props;
---

<article
  class={`reveal group relative flex flex-col rounded-xl border border-white/10 bg-ink-800/60 p-6 transition hover:border-accent/40 hover:bg-ink-800 ${
    big ? 'md:flex-row md:gap-8' : ''
  }`}
>
  <div class={big ? 'md:flex-1' : ''}>
    <div class="flex flex-wrap items-center gap-3">
      <h4 class="text-lg font-semibold text-white">{project.name}</h4>
      {
        project.featured && (
          <span class="rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent">
            At work
          </span>
        )
      }
    </div>
    <p class="mt-1 text-sm text-zinc-500">{project.tagline}</p>
    <p class="mt-4 text-[15px] leading-relaxed text-zinc-400">{project.description}</p>
    {
      big && (
        <ul class="mt-4 space-y-2 text-sm text-zinc-500">
          {project.highlights.slice(0, 2).map((h) => (
            <li class="flex gap-2.5">
              <span class="mt-[8px] h-1 w-2.5 shrink-0 rounded-full bg-accent/60"></span>
              {h}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <div class={`mt-5 flex flex-col gap-4 ${big ? 'md:mt-0 md:w-56 md:justify-between' : ''}`}>
    <ul class="flex flex-wrap gap-2">
      {project.tech.map((t) => (
        <li class="rounded-md bg-white/5 px-2 py-1 font-mono text-[11px] text-zinc-400">{t}</li>
      ))}
    </ul>
    <div class="flex flex-wrap gap-4 text-sm">
      {project.links.map((l) => (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-xs text-accent transition hover:text-accent-soft"
        >
          {l.label} →
        </a>
      ))}
    </div>
  </div>
</article>
