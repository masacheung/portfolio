---
import { Site } from '../data/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-white/5 bg-ink-900/60">
  <div class="mx-auto max-w-6xl px-5 py-24 text-center">
    <p class="reveal font-mono text-sm uppercase tracking-[0.3em] text-accent">Contact</p>
    <h3 class="reveal mt-4 text-3xl font-bold text-white md:text-5xl">Let's build something.</h3>
    <p class="reveal mx-auto mt-4 max-w-xl text-zinc-500">
      Open to interesting problems, new teams, and good conversations about trading systems.
    </p>
    <div class="reveal mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`mailto:${Site.email}`}
        class="rounded-md bg-accent px-6 py-3 text-sm font-semibold text-ink-950 transition hover:bg-accent-soft"
      >
        {Site.email}
      </a>
      <a
        href={Site.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
      >
        LinkedIn
      </a>
      <a
        href={Site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md border border-white/15 px-6 py-3 text-sm font-semibold text-white transition hover:border-accent/50 hover:text-accent"
      >
        GitHub
      </a>
    </div>
  </div>
  <div class="border-t border-white/5 py-6">
    <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-2 px-5 font-mono text-xs text-zinc-600 md:flex-row">
      <p>© {year} Masa Cheung</p>
      <p>
        Built with <a href="https://astro.build" class="hover:text-zinc-400">Astro</a> +
        <a href="https://tailwindcss.com" class="hover:text-zinc-400"> Tailwind</a>
      </p>
    </div>
  </div>
</footer>
