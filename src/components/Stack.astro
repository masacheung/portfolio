---
const groups = [
  {
    title: 'Languages & Core',
    items: ['JavaScript (ES6+)', 'TypeScript', 'Java', 'HTML5', 'CSS / SCSS'],
  },
  {
    title: 'Frameworks',
    items: ['React', 'Redux', 'Node.js / Express.js', 'Ruby on Rails', 'Vue.js'],
  },
  {
    title: 'Data',
    items: ['PostgreSQL', 'MongoDB', 'WebSockets'],
  },
  {
    title: 'DevOps & Tooling',
    items: ['Docker', 'GitLab CI', 'Prometheus', 'Grafana', 'Git', 'Webpack'],
  },
  {
    title: 'Practice',
    items: ['Test Driven Development', 'Agile / Scrum', 'Root-cause analysis', 'API design'],
  },
];
---

<section id="stack" class="border-t border-white/5 py-24 md:py-32">
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="reveal font-mono text-sm uppercase tracking-[0.3em] text-accent">Stack</h2>
    <h3 class="reveal mt-3 text-3xl font-bold text-white md:text-4xl">Tools I work with</h3>

    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        groups.map((g) => (
          <div class="reveal">
            <h4 class="font-mono text-xs uppercase tracking-widest text-zinc-500">{g.title}</h4>
            <ul class="mt-4 flex flex-wrap gap-2">
              {g.items.map((i) => (
                <li class="rounded-lg border border-white/10 bg-white/[0.03] px-3 py-1.5 text-sm text-zinc-300 transition hover:border-accent/40 hover:text-white">
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
